{
  "name": "@mateusz-klatt/snapper-mcp",
  "version": "0.12.0",
  "description": "Lightweight stdio-to-HTTP MCP bridge from Claude Desktop / Claude Code to Snapper /api/mcp, with a `watch` subcommand that streams live signal + order events as JSONL via the /api/auth/ws_token endpoint.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "snapper-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusz-klatt/snapper-mcp.git"
  },
  "homepage": "https://github.com/mateusz-klatt/snapper-mcp#readme",
  "bugs": {
    "url": "https://github.com/mateusz-klatt/snapper-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "claude-code",
    "snapper",
    "bridge",
    "stdio",
    "http"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "stdout-gate": "node scripts/stdout-gate.mjs src",
    "prepare": "simple-git-hooks || true",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10",
    "globals": "^17.8.0",
    "simple-git-hooks": "^2.13",
    "tsup": "^8",
    "typescript": "^6.0",
    "vitest": "^4.1"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx gitleaks protect --staged -v --config=.gitleaks.toml"
  },
  "publishConfig": {
    "access": "public"
  }
}
