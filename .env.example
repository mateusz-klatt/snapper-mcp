SNAPPER_BASE_URL=http://localhost:8000/api/mcp
SNAPPER_ACCESS_TOKEN=jwt-placeholder

# Optional: select a profile at spawn time (or use --profile=NAME).
# When set, the bridge ignores the bare vars above and reads from
# SNAPPER_PROFILE_<UPPER>_BASE_URL + SNAPPER_PROFILE_<UPPER>_ACCESS_TOKEN.
# Profile name regex: ^[a-z0-9]{1,32}$.
# SNAPPER_PROFILE=prod
# SNAPPER_PROFILE_PROD_BASE_URL=https://snapper.example.com/api/mcp
# SNAPPER_PROFILE_PROD_ACCESS_TOKEN=jwt-placeholder
# SNAPPER_PROFILE_STAGING_BASE_URL=https://staging.example.com/api/mcp
# SNAPPER_PROFILE_STAGING_ACCESS_TOKEN=jwt-placeholder
